#!/bin/bash -1

#PBS -N tourism_job
#PBS -l select=1:ncpus=10:mem=96gb
#PBS -l walltime=06:00:00
#PBS -J 1-121
#PBS -m abe
#PBS -j oe
cd $PBS_O_WORKDIR

MASTER_JID=$(echo ${PBS_JOBID} | sed 's/\[.*$//')

JOB_DIR=${PBS_JOBNAME}_${MASTER_JID}
mkdir -p ${JOB_DIR}/stanfits ${JOB_DIR}/accuracy ${JOB_DIR}/logs

conda activate your_environment

Rscript purposes_hierarchy_coherency.R ${JOB_DIR} 2> ${JOB_DIR}/logs/log_${PBS_ARRAY_INDEX}.txt
